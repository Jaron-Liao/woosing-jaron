# 服务端环境变量（复制为 .env 后填真实值，.env 不要提交到仓库）

# 必填：公众号（已认证服务号）
WECHAT_APPID=
WECHAT_APP_SECRET=

# 必填：本服务对外地址，必须与公众号后台「网页授权域名」一致，不带结尾斜杠
BASE_URL=https://codeverse-workbench.app.workbuddy.host

# 必填：票据签名密钥，≥32 位随机串
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# 方案 A：CloudBase 自定义登录（把微信 openid 变成正式云端账号）
# 设为 1 开启；开启后下面两项必填
CUSTOM_LOGIN_ENABLED=0
# 腾讯云 CloudBase 环境 ID（不是应用 ID wbapp_ 开头那个）
CLOUDBASE_ENV=
# 自定义登录私钥 JSON 的绝对路径，例如 /secure/cv/tcb_custom_login.json
# 从 CloudBase 控制台「身份认证 → 登录方式 → 自定义登录」下载
# 注意：只写路径，绝不把私钥内容写进本文件；也不要放进仓库目录
CLOUDBASE_CUSTOM_LOGIN_KEY=

# 选填
WECHAT_SCOPE=snsapi_userinfo
PORT=3000
HOST=0.0.0.0
STATIC_DIR=dist
